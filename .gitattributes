# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# PowerShell scripts require CRLF on Windows execution compatibility
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
